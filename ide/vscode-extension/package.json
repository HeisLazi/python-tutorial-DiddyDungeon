{
  "name": "python-quest-lab",
  "displayName": "Python Quest Lab",
  "description": "Gamified Python learning dashboard for Python Quest Lab.",
  "version": "0.1.0",
  "publisher": "HeisLazi",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:questlab.openDashboard"],
